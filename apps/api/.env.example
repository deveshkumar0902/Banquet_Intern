# Copy to .env. Everything is optional in development: the API boots with defaults and logs emails.
# In production (NODE_ENV=production) every key marked [required in prod] must be set.

NODE_ENV=development
# [required in prod] Port to listen on
PORT=4000
# [required in prod] Comma-separated list of allowed browser origins (the website URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# [required in prod] SQLite file. Put it on a persistent disk in production (e.g. /var/data/app.db)
DATABASE_PATH=./data/app.db

# Email. Leave SMTP_HOST empty in development to log emails to the console instead.
# [required in prod]
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=false
# [required in prod]
SMTP_USER=
# [required in prod]
SMTP_PASS=
# [required in prod] Sender shown to customers
MAIL_FROM="Dev Marriage Hall <no-reply@example.com>"
# [required in prod] Receives a copy of every enquiry and contact message
OWNER_EMAIL=

# [required in prod, min 32 chars] Bearer token for /api/admin/* exports. Generate: openssl rand -hex 32
ADMIN_TOKEN=

# Set to 1 behind one reverse proxy (Render, Railway) so rate limits see the real client IP
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Form submissions allowed per IP per 15 minutes (raise only for automated tests)
RATE_LIMIT_MAX=5

# Shown in email headers/footers
BRAND_NAME=Dev Marriage Hall
BRAND_PHONE=
BRAND_ADDRESS=
