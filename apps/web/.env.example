# API origin. Empty = same origin (the Vite dev/preview server proxies /api to localhost:4000).
# Production example: https://banquet-api.onrender.com
VITE_API_URL=
# Base path the site is served from. GitHub Pages project site: /Banquet_Intern/
VITE_BASE_PATH=/
# Public URL of the site, used for canonical links, Open Graph and the sitemap (no trailing slash)
VITE_SITE_URL=http://localhost:5173
# Set to true to show testimonials and stats that the owner hasn't verified yet in a production build
VITE_SHOW_UNVERIFIED=false
